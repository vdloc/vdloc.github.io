---
import { ModeToggle } from './react/DarkModeToggle';
import MobileDrawer from './react/MobileDrawer';
---

<header
  class='flex items-center justify-between py-4 px-6 border-b border-foreground sticky top-0 z-10 bg-background'
>
  <MobileDrawer client:load />
  <div
    class='justify-self-end py-2 flex items-center content-center text-text-bold d-none'
  >
  </div>
  <ModeToggle client:load />
</header>

<script is:inline>
  import { Theme } from '@/types/enums';

  const getThemePreference = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? Theme.DARK
      : Theme.LIGHT;
  };
  const isDark = getThemePreference() === Theme.DARK;
  document.documentElement.classList[isDark ? 'add' : 'remove'](Theme.DARK);

  if (typeof localStorage !== 'undefined') {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains(Theme.DARK);
      localStorage.setItem('theme', isDark ? Theme.DARK : Theme.LIGHT);
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }
</script>
