---
import AsideNav from '@/components/react/AsideNav';
import { ModeToggle } from './react/DarkModeToggle';
import MobileDrawer from './react/MobileDrawer';
---

<header
  class='lg:hidden flex items-center justify-between py-4 px-6 border-b border-foreground sticky top-0 z-10 bg-background'
>
  <aside class='grid lg:hidden'>
    <MobileDrawer client:load />
  </aside>

  <ModeToggle client:load />
</header>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'theme-light';
  };
  const isDark = getThemePreference() === 'dark';
  document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

  if (typeof localStorage !== 'undefined') {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'theme-light');
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }
</script>
