---
import PostList from './PostList.astro'
---

<div class="container mx-auto px-6">
  <section class='pt-8'>
    <h3 class="font-semibold text-2xl leading-none">
      Home
    </h3>
    <p class="mt-7">
      My name is <strong>Loc</strong> ("Lộc"). It means "green leaf" or "lucky" in
      English.
    </p>
  </section>
  <section class="mt-7">
    <h3 class="font-semibold text-lg mb-2">
      Writing
    </h3>
    <PostList className="mt-7"/>
  </section>
</div>


