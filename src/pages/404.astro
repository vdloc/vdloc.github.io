---
import PageLayout from '../layouts/PageLayout.astro';
import PageMeta from '../components/PageMeta.astro';
import { SITE_TITLE } from '../config';
---

<PageLayout forceDark>
  <PageMeta title={`404 | ${SITE_TITLE}`} slot='meta' />
  <section slot='main' class='text-center py-12' lang='vi'>
    <h1 class='text-3xl font-bold mb-4 text-text-heading'>
      Không tìm thấy trang
    </h1>
    <p class='mb-6 text-text-body'>
      Trang bạn tìm không tồn tại, hoặc đường dẫn đã thay đổi.
    </p>
    <a
      href='/blog'
      class='unset
          transition-[background-size] duration-300
          bg-gradient-to-r bg-left-bottom bg-no-repeat
          bg-[length:100%_2px] hover:bg-[length:100%_55%] dark:hover:bg-[length:100%_2px]
          from-primary-blue to-primary-blue dark:from-primary-blue dark:to-primary-blue'
    >
      &larr; Về trang Blog
    </a>
  </section>
</PageLayout>
