---
import { readAll } from '../lib/markdoc/read';
import { blog } from '../lib/markdoc/frontmatter.schema';
import PageLayout from '../layouts/PageLayout.astro';
import PageMeta from '../components/PageMeta.astro';
import { SITE_TITLE } from '../config';
import { sortPostsByDate } from 'src/utils';

const posts = await readAll({
  directory: 'blog',
  frontmatterSchema: blog,
});

const sortedPosts = sortPostsByDate(posts);
---

<PageLayout forceDark>
  <PageMeta title={`Blog | ${SITE_TITLE}`} slot='meta' />
  <section slot='main'>
    <h1 class='text-3xl font-bold mb-6 text-text-heading'>Bài viết</h1>
    <ul>
      {
        sortedPosts.map((post) => {
          const formattedDate = new Date(
            post.frontmatter.date
          ).toLocaleDateString('vi-VN', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <li class='grid grid-cols-[1fr] md:grid-cols-[1fr_auto] mb-3 md:gap-2 items-start'>
              <div class='title'>
                {post.frontmatter.external ? (
                  <a
                    href={post.frontmatter.url}
                    target='_blank'
                    class='unset
                        transition-[background-size] duration-300
                        bg-gradient-to-r bg-left-bottom bg-no-repeat
                        bg-[length:100%_2px] hover:bg-[length:100%_55%] dark:hover:bg-[length:100%_2px]
                        from-primary-blue to-primary-blue dark:from-primary-blue dark:to-primary-blue
                      '
                  >
                    <span>{post.frontmatter.title}</span>
                    <span>
                      <i class='ml-1 mr-1 text-[12px] pb-2 fa-solid fa-up-right-from-square' />
                    </span>
                  </a>
                ) : (
                  <>
                    <a
                      href={`/blog/${post.slug}`}
                      lang='vi'
                      class='unset
                          transition-[background-size] duration-300
                          bg-gradient-to-r bg-left-bottom bg-no-repeat
                          bg-[length:100%_2px] hover:bg-[length:100%_55%] dark:hover:bg-[length:100%_2px]
                          from-primary-blue to-primary-blue dark:from-primary-blue dark:to-primary-blue
                        '
                    >
                      {post.frontmatter.title}
                    </a>
                    {post.frontmatter.description && (
                      <p class='m-0 mt-1 text-text-muted text-sm' lang='vi'>
                        {post.frontmatter.description}
                      </p>
                    )}
                  </>
                )}
              </div>
              <div class='text-text-muted text-sm italic pt-1'>
                <time datetime={post.frontmatter.date.toISOString()}>
                  {formattedDate}
                </time>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
</PageLayout>

<style>
  @keyframes list-item-fade-up {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  ul > li {
    animation: list-item-fade-up 400ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  ul > li:nth-child(1) {
    animation-delay: 60ms;
  }
  ul > li:nth-child(2) {
    animation-delay: 120ms;
  }
  ul > li:nth-child(3) {
    animation-delay: 180ms;
  }
  ul > li:nth-child(n + 4) {
    animation-delay: 240ms;
  }

  @media (prefers-reduced-motion: reduce) {
    ul > li {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
