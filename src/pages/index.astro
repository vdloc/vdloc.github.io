---
import PageMeta from '../components/PageMeta.astro';
import PageLayout from '../layouts/PageLayout.astro';
import Intro from '../components/Intro.astro';
import AutomatonField from '../components/AutomatonField.astro';
import { SITE_TITLE } from '../config';
---

<PageLayout forceDark>
  <PageMeta title={`${SITE_TITLE} | @vdloc.me`} slot='meta' />
  <Fragment slot='main'>
    <AutomatonField />
    <Intro />
  </Fragment>
</PageLayout>
